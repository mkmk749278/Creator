node_modules/
.venv/
__pycache__/
*.pyc
*.egg-info/
video/spike-4k/
# vendored at npm install time (scripts/vendor-assets.mjs)
video/**/vendor/
video/**/snapshots/
video/**/renders/
*.mp4
# run artefacts: only manifests are committed
runs/*/*
!runs/*/manifest.json
!runs/.gitkeep
spike-out/
# copied into each part by scripts/new_part.mjs
video/pixel11/p*/media/
video/pixel11/p*/shared/
video/pixel11/p*/voice.wav
video/pixel11v2/p*/media/
video/pixel11v2/p*/shared/
video/pixel11v2/p*/samples/
video/pixel11v2/p*/voice.wav
video/pixel11/_samples/video_sources/
video/breathhold/p*/shared/
video/breathhold/p*/voice.wav
video/breathhold/p*/media/
# owner footage is large; keep it out of git (README stays)
assets/video/*
assets/images/*
assets/audio/*
video/doc/p*/media/
video/doc/p*/shared/
video/doc/p*/voice.wav
runs/breath-hold/doc/parts/
assets/raw/
# documentary projects: downloaded media stays local
projects/*/assets/
projects/*/out/
video/prahlad_4k/
# generated by scripts/make_lipsync.py (Kokoro TTS)
video/duo-talk/voice.wav

# shared asset library: large files are re-fetched by scripts/library.py fetch
library/_cache/
video/fireice/*/shared/
video/fireice/*/render.mp4
video/fireice/*/render.log
projects/*/out_*.log
video/**/.render.hf-transaction-*/
video/**/work-*/
video/minimumdue/*/render.mp4
video/minimumdue/*/render.log
.cache/
video/jet-engine-paradox/A*/media/
video/jet-engine-paradox/A*/render.log
video/jet-engine-paradox/_libA/render_status.txt
video/jet-engine-paradox/A*/qa/
# VO takes live in Google Drive (Creator/jet-engine-paradox/voice/), not git
projects/jet-engine-paradox/voice/*.mp3
video/jet-engine-paradox/_libA/links.txt
projects/jet-engine-paradox/qa/
# thumbnail inputs are regenerated from assets (thumb.html + thumbnail.jpg are kept)
projects/jet-engine-paradox/thumbnail/*.png
projects/jet-engine-paradox/thumbnail/pixabay_*.jpg
video/insurance-ombudsman/*/media/
video/insurance-ombudsman/*/render.log
