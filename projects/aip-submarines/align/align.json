  "te": "The new engine wasn't ready.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.424,
  "confidence": "high"
 },
 {
  "line": 153,
  "start": 434.303,
  "end": 435.871,
  "te": "The boat came out without it.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.424,
  "confidence": "high"
 },
 {
