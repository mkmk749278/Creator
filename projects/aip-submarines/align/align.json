  "speech_vs_text": 0.92,
  "boundary_margin": 0.405,
  "confidence": "high"
 },
 {
  "line": 161,
  "start": 460.831,
  "end": 466.267,
  "te": "And the Defence Secretary says the fitting comes around the middle of next year, with sea trials to follow.",
  "en": "",
  "speech_vs_text": 0.82,
  "boundary_margin": 0.405,
  "confidence": "high"
 },
 {
  "line": 162,
  "start": 466.714,
