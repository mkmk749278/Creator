  "te": "The window closed.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.309,
  "confidence": "high"
 },
 {
  "line": 155,
  "start": 438.038,
  "end": 440.862,
  "te": "So if you were in charge, how would you break the trap?",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.309,
  "confidence": "high"
 },
 {
  "line": 156,
  "start": 441.326,
  "end": 442.974,
  "te": "You'd start with one submarine.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.84,
  "confidence": "high"
 },
 {
  "line": 157,
  "start": 443.382,
  "end": 445.66,
  "te": "Reports say it will be I-N-S Khanderi.",
  "en": "",
  "speech_vs_text": 1.18,
  "boundary_margin": 0.452,
  "confidence": "high"
 },
 {
  "line": 158,
  "start": 446.81,
  "end": 453.662,
  "te": "This October, the heart of this machine started its next round of tests, at L and T's yard in Hazira, Gujarat.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.2,
  "confidence": "high"
 },
 {
  "line": 159,
  "start": 454.226,
  "end": 457.686,
  "te": "Next, it gets powered up and tested to the Navy's rules.",
