  "speech_vs_text": 1.12,
  "boundary_margin": 1.448,
  "confidence": "high"
 },
 {
  "line": 95,
  "start": 285.208,
  "end": 287.915,
  "te": "The carbon dioxide you breathe out gets cleaned away.",
