  "start": 399.792,
  "end": 401.871,
  "te": "Nobody is allowed to mine there yet.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 2.207,
  "confidence": "high"
 },
 {
  "line": 128,
  "start": 402.248,
  "end": 404.111,
  "te": "The world is still writing the rules.",
