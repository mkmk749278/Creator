  "speech_vs_text": 1.09,
  "boundary_margin": 0.173,
  "confidence": "high"
 },
 {
  "line": 118,
  "start": 365.861,
  "end": 368.854,
  "te": "Your lights are the only lights for six kilometres.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.319,
  "confidence": "high"
 },
 {
  "line": 119,
  "start": 369.451,
  "end": 372.716,
  "te": "Outside your window, the water is close to freezing.",
