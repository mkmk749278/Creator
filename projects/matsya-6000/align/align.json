  "speech_vs_text": 0.99,
  "boundary_margin": 0.192,
  "confidence": "high"
 },
 {
  "line": 115,
  "start": 356.918,
  "end": 358.729,
  "te": "So why do all this, you ask?",
  "en": "",
  "speech_vs_text": 1.21,
  "boundary_margin": 0.192,
  "confidence": "high"
 },
 {
  "line": 116,
  "start": 359.138,
  "end": 361.091,
  "te": "What's down there that's worth it?",
