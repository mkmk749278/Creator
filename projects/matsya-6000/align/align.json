  "speech_vs_text": 1.08,
  "boundary_margin": 1.28,
  "confidence": "high"
 },
 {
  "line": 110,
  "start": 334.205,
  "end": 337.739,
  "te": "That foam had to come from France, and it arrived late.",
  "en": "",
  "speech_vs_text": 1.14,
  "boundary_margin": 0.142,
  "confidence": "high"
 },
 {
  "line": 111,
  "start": 338.043,
  "end": 342.48,
  "te": "Then, early this year, officials said a small crack was found in its cover.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.142,
  "confidence": "high"
 },
 {
  "line": 112,
  "start": 342.764,
  "end": 345.941,
  "te": "That held up the first test dive, to five hundred metres.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.372,
  "confidence": "high"
 },
 {
  "line": 113,
  "start": 346.292,
  "end": 351.555,
  "te": "On the sixth of November, Matsya finished another round of trials near Chennai, without people inside.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.331,
  "confidence": "high"
 },
 {
  "line": 114,
  "start": 351.878,
  "end": 356.588,
  "te": "Officials have said the full six kilometre dive could come in twenty twenty-seven.",
