  "te": "So it's wrapped in a special foam.",
  "en": "",
  "speech_vs_text": 1.27,
  "boundary_margin": 0.454,
  "confidence": "high"
 },
 {
  "line": 107,
  "start": 325.279,
  "end": 329.63,
  "te": "The foam is full of tiny hollow glass bubbles, set in hard plastic.",
