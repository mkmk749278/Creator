[
 {
  "line": 1,
  "start": 0.0,
  "end": 1.662,
  "te": "The twenty-ninth of October.",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.466,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 2.122,
  "end": 8.345,
  "te": "A Rafale fighter, here for trials, comes down on India's newest aircraft carrier, I-N-S Vikrant.",
  "en": "",
  "speech_vs_text": 1.09,
  "boundary_margin": 0.191,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 8.795,
  "end": 13.602,
  "te": "This deck is missing something that India's first carrier had, back in nineteen sixty-one.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.191,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 14.146,
  "end": 14.86,
  "te": "A catapult.",
  "en": "",
  "speech_vs_text": 1.23,
  "boundary_margin": 1.261,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 15.284,
  "end": 17.99,
  "te": "The Rafale was built to be thrown off a ship by one.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.282,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 18.46,
  "end": 20.075,
  "te": "Vikrant has a ramp instead.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.282,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 20.489,
  "end": 22.073,
  "te": "The jet can leave by that ramp.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.988,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 22.42,
  "end": 23.848,
  "te": "It passed that test in Goa.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 24.253,
  "end": 25.129,
  "te": "But think about this.",
  "en": "",
  "speech_vs_text": 0.8,
  "boundary_margin": 0.454,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 25.49,
  "end": 29.323,
  "te": "Sixty-five years ago, India was throwing jets off a ship.",
  "en": "",
  "speech_vs_text": 1.16,
  "boundary_margin": 0.078,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 29.742,
  "end": 35.993,
  "te": "Today the Navy wants a catapult again — and the one India is building so far, is a small test model.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.078,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 36.68,
  "end": 37.935,
  "te": "So what happened in between?",
  "en": "",
  "speech_vs_text": 0.84,
  "boundary_margin": 0.461,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 38.323,
  "end": 40.278,
  "te": "And here is something you would not guess.",
  "en": "",
  "speech_vs_text": 0.89,
  "boundary_margin": 0.685,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 40.631,
  "end": 45.078,
  "te": "The electricity to throw a fighter jet costs you less than two hundred rupees.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.078,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 45.419,
  "end": 48.128,
  "te": "Yet it is one of the hardest machines on earth.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.078,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 48.46,
  "end": 50.617,
  "te": "By the end of this film, you will see why.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.59,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 51.107,
  "end": 53.046,
  "te": "Come and stand on Vikrant's deck with me.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.258,
  "confidence": "high"
 },
 {
  "line": 18,
  "start": 53.441,
  "end": 57.978,
  "te": "In front of you, the deck curves upward, like a flyover that ends in the sky.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.258,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 58.373,
  "end": 60.367,
  "te": "Do you see any moving parts on that ramp?",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.331,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 60.799,
  "end": 61.07,
  "te": "None.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 2.688,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 61.47,
  "end": 65.47,
  "te": "The jet opens its engines fully, runs, and the curve throws it up.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.631,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 65.93,
  "end": 66.922,
  "te": "Nothing you can break.",
  "en": "",
  "speech_vs_text": 0.85,
  "boundary_margin": 0.631,
  "confidence": "high"
 },
 {
  "line": 23,
  "start": 67.203,
  "end": 68.319,
  "te": "Nothing you must repair.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.35,
  "confidence": "high"
 },
 {
  "line": 24,
  "start": 68.698,
  "end": 71.062,
  "te": "You have to admit, it is a clever idea.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.35,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 71.432,
  "end": 72.272,
  "te": "But here's the catch.",
  "en": "",
  "speech_vs_text": 0.81,
  "boundary_margin": 0.255,
  "confidence": "high"
 },
 {
  "line": 26,
  "start": 72.611,
  "end": 76.557,
  "te": "On a ramp, the jet must lift itself, with its own engines.",
  "en": "",
  "speech_vs_text": 1.19,
  "boundary_margin": 0.255,
  "confidence": "high"
 },
 {
  "line": 27,
  "start": 76.859,
  "end": 78.307,
  "te": "So you take off lighter.",
  "en": "",
  "speech_vs_text": 1.18,
  "boundary_margin": 0.404,
  "confidence": "high"
 },
 {
  "line": 28,
  "start": 78.642,
  "end": 81.351,
  "te": "You carry less fuel, or fewer weapons, or both.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.316,
  "confidence": "high"
 },
 {
  "line": 29,
  "start": 81.898,
  "end": 82.57,
  "te": "How much lighter?",
  "en": "",
  "speech_vs_text": 0.74,
  "boundary_margin": 0.316,
  "confidence": "high"
 },
 {
  "line": 30,
  "start": 82.925,
  "end": 84.8,
  "te": "The Navy has not published that number.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 31,
  "start": 85.064,
  "end": 86.643,
  "te": "So I won't invent one for you.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 32,
  "start": 87.044,
  "end": 89.075,
  "te": "What nobody argues about is this.",
  "en": "",
  "speech_vs_text": 1.16,
  "boundary_margin": 0.238,
  "confidence": "high"
 },
 {
  "line": 33,
  "start": 89.413,
  "end": 93.206,
  "te": "You cannot get a heavy, slow aircraft off a ramp at all.",
  "en": "",
  "speech_vs_text": 1.3,
  "boundary_margin": 0.238,
  "confidence": "high"
 },
 {
  "line": 34,
  "start": 93.525,
  "end": 95.819,
  "te": "And which heavy aircraft matters most at sea?",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 4.844,
  "confidence": "high"
 },
 {
  "line": 35,
  "start": 96.136,
  "end": 97.136,
  "te": "The flying radar.",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 1.46,
  "confidence": "high"
 },
 {
  "line": 36,
  "start": 97.478,
  "end": 101.861,
  "te": "A plane with a big dish on its back, that sees trouble long before your ship can.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.957,
  "confidence": "high"
 },
 {
  "line": 37,
  "start": 102.236,
  "end": 104.593,
  "te": "India's carriers do that job with a helicopter.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.957,
  "confidence": "high"
 },
 {
  "line": 38,
  "start": 104.953,
  "end": 105.468,
  "te": "It works.",
  "en": "",
  "speech_vs_text": 1.14,
  "boundary_margin": 2.5,
  "confidence": "high"
 },
 {
  "line": 39,
  "start": 105.76,
  "end": 110.918,
  "te": "But ask naval experts, and they will tell you, a helicopter cannot do it as well as a plane.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 1.209,
  "confidence": "high"
 },
 {
  "line": 40,
  "start": 111.331,
  "end": 112.964,
  "te": "So the ramp has a price.",
  "en": "",
  "speech_vs_text": 1.4,
  "boundary_margin": 1.209,
  "confidence": "high"
 },
 {
  "line": 41,
  "start": 113.353,
  "end": 114.743,
  "te": "Then why did India choose it?",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.305,
  "confidence": "high"
 },
 {
  "line": 42,
  "start": 115.101,
  "end": 120.058,
  "te": "To answer that, you must first see the catapult we already had, and how we let it go.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.283,
  "confidence": "high"
 },
 {
  "line": 43,
  "start": 120.564,
  "end": 123.398,
  "te": "Belfast, the fourth of March, nineteen sixty-one.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.283,
  "confidence": "high"
 },
 {
  "line": 44,
  "start": 123.772,
  "end": 128.955,
  "te": "India commissions its first aircraft carrier, bought from Britain and finished in that shipyard.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.533,
  "confidence": "high"
 },
 {
  "line": 45,
  "start": 129.367,
  "end": 130.916,
  "te": "Her name, too, is Vikrant.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.464,
  "confidence": "high"
 },
 {
  "line": 46,
  "start": 131.364,
  "end": 133.646,
  "te": "And under her deck is a steam catapult.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.464,
  "confidence": "high"
 },
 {
  "line": 47,
  "start": 134.051,
  "end": 135.557,
  "te": "How does steam throw a jet?",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.918,
  "confidence": "high"
 },
 {
  "line": 48,
  "start": 135.926,
  "end": 137.321,
  "te": "You already own a small one.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 49,
  "start": 137.597,
  "end": 139.001,
  "te": "The pressure cooker in your kitchen.",
  "en": "",
  "speech_vs_text": 0.72,
  "boundary_margin": 0.52,
  "confidence": "high"
 },
 {
  "line": 50,
  "start": 139.358,
  "end": 143.598,
  "te": "Steam builds up behind the weight, and when it goes, it goes with force.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.119,
  "confidence": "high"
 },
 {
  "line": 51,
  "start": 143.888,
  "end": 149.67,
  "te": "On the ship, that steam drives a piston along a tube under the deck, and the piston drags the jet.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.119,
  "confidence": "high"
 },
 {
  "line": 52,
  "start": 150.008,
  "end": 151.6,
  "te": "For nine years, it works.",
  "en": "",
  "speech_vs_text": 1.29,
  "boundary_margin": 0.186,
  "confidence": "high"
 },
 {
  "line": 53,
  "start": 151.921,
  "end": 156.918,
  "te": "Then, in June nineteen seventy, in Bombay, the engineers find cracks in a boiler.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.186,
  "confidence": "high"
 },
 {
  "line": 54,
  "start": 157.281,
  "end": 158.028,
  "te": "Not one crack.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.265,
  "confidence": "high"
 },
 {
  "line": 55,
  "start": 158.344,
  "end": 160.696,
  "te": "Many, in the drums that hold the water.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.265,
  "confidence": "high"
 },
 {
  "line": 56,
  "start": 161.019,
  "end": 162.109,
  "te": "You cannot weld them.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 2.101,
  "confidence": "high"
 },
 {
  "line": 57,
  "start": 162.585,
  "end": 165.057,
  "te": "And a lasting repair is not possible in India.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 58,
  "start": 165.566,
  "end": 166.526,
  "te": "Do you see what that means?",
  "en": "",
  "speech_vs_text": 0.71,
  "boundary_margin": 0.292,
  "confidence": "high"
 },
 {
  "line": 59,
  "start": 166.935,
  "end": 170.93,
  "te": "The same steam that turns the propellers, also fires the catapult.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.292,
  "confidence": "high"
 },
 {
  "line": 60,
  "start": 171.232,
  "end": 176.753,
  "te": "If you push those boilers too hard, in the words of Admiral Arun Prakash, they could simply blow up.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.319,
  "confidence": "high"
 },
 {
  "line": 61,
  "start": 177.333,
  "end": 178.66,
  "te": "Would you send that ship to war?",
  "en": "",
  "speech_vs_text": 0.82,
  "boundary_margin": 0.497,
  "confidence": "high"
 },
 {
  "line": 62,
  "start": 179.171,
  "end": 181.27,
  "te": "So the ship is held to fourteen knots.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.301,
  "confidence": "high"
 },
 {
  "line": 63,
  "start": 181.559,
  "end": 183.599,
  "te": "That is about twenty-six kilometres an hour.",
  "en": "",
  "speech_vs_text": 0.81,
  "boundary_margin": 0.301,
  "confidence": "high"
 },
 {
  "line": 64,
  "start": 184.079,
  "end": 185.163,
  "te": "Too slow for a carrier.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 1.358,
  "confidence": "high"
 },
 {
  "line": 65,
  "start": 185.522,
  "end": 188.975,
  "te": "And some very senior officers say, leave her out of the next war.",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.284,
  "confidence": "high"
 },
 {
  "line": 66,
  "start": 189.457,
  "end": 192.348,
  "te": "The Navy chief, Admiral Nanda, will not have it.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.019,
  "confidence": "check"
 },
 {
  "line": 67,
  "start": 192.653,
  "end": 198.697,
  "te": "If Vikrant sits out a war, he says, she will be called a white elephant, and naval flying will be written off.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.019,
  "confidence": "check"
 },
 {
  "line": 68,
  "start": 199.226,
  "end": 202.183,
  "te": "So it comes down to the engine room, and to one man.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.274,
  "confidence": "high"
 },
 {
  "line": 69,
  "start": 202.547,
  "end": 205.423,
  "te": "Commander Benoy Roy Chowdhury, the ship's engineer.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.274,
  "confidence": "high"
 },
 {
  "line": 70,
  "start": 205.768,
  "end": 207.293,
  "te": "His shipmates call him Beeloo.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.464,
  "confidence": "high"
 },
 {
  "line": 71,
  "start": 207.7,
  "end": 210.5,
  "te": "What would you do with a cracked boiler, and no spare?",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 72,
  "start": 210.911,
  "end": 213.278,
  "te": "Beeloo and his team put steel bands around it.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.924,
  "confidence": "high"
 },
 {
  "line": 73,
  "start": 213.681,
  "end": 216.607,
  "te": "They reset the safety valves, to accept more risk.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.494,
  "confidence": "high"
 },
 {
  "line": 74,
  "start": 216.973,
  "end": 219.256,
  "te": "And they keep the boiler room almost empty.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.484,
  "confidence": "high"
 },
 {
  "line": 75,
  "start": 219.727,
  "end": 223.452,
  "te": "Because if a drum bursts, that room fills with superheated steam.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.484,
  "confidence": "high"
 },
 {
  "line": 76,
  "start": 224.064,
  "end": 224.661,
  "te": "It holds.",
  "en": "",
  "speech_vs_text": 1.32,
  "boundary_margin": 2.41,
  "confidence": "high"
 },
 {
  "line": 77,
  "start": 225.043,
  "end": 231.626,
  "te": "On the fourth of December, nineteen seventy-one, Sea Hawk jets leave Vikrant's catapult, and strike Cox's Bazar.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.296,
  "confidence": "high"
 },
 {
  "line": 78,
  "start": 231.997,
  "end": 237.154,
  "te": "And for his work in that boiler room, Beeloo is given the Vir Chakra, a medal for bravery.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.296,
  "confidence": "high"
 },
 {
  "line": 79,
  "start": 237.518,
  "end": 239.694,
  "te": "So India did not only have a catapult.",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.44,
  "confidence": "high"
 },
 {
  "line": 80,
  "start": 240.161,
  "end": 243.606,
  "te": "India kept one alive with steel bands, and took it to war.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.412,
  "confidence": "high"
 },
 {
  "line": 81,
  "start": 244.091,
  "end": 245.393,
  "te": "Then how did we lose it?",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.412,
  "confidence": "high"
 },
 {
  "line": 82,
  "start": 245.754,
  "end": 250.577,
  "te": "In the nineteen eighties, the Navy bought the Sea Harrier, a jet that needs no catapult.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.432,
  "confidence": "high"
 },
 {
  "line": 83,
  "start": 251.024,
  "end": 256.841,
  "te": "The last planes that still needed the catapult, the old propeller planes, retired in nineteen eighty-nine.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.432,
  "confidence": "high"
 },
 {
  "line": 84,
  "start": 257.305,
  "end": 259.889,
  "te": "So the catapult came out, and a ramp went on.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.652,
  "confidence": "high"
 },
 {
  "line": 85,
  "start": 260.312,
  "end": 260.991,
  "te": "You can see why.",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 0.797,
  "confidence": "high"
 },
 {
  "line": 86,
  "start": 261.383,
  "end": 262.287,
  "te": "It made sense then.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 1.294,
  "confidence": "high"
 },
