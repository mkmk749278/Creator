[
 {
  "line": 1,
  "start": 0.0,
  "end": 1.662,
  "te": "The twenty-ninth of October.",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.467,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 2.122,
  "end": 8.345,
  "te": "A Rafale fighter, here for trials, comes down on India's newest aircraft carrier, I-N-S Vikrant.",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 0.191,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 8.795,
  "end": 13.602,
  "te": "This deck is missing something that India's first carrier had, back in nineteen sixty-one.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.191,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 14.146,
  "end": 14.86,
  "te": "A catapult.",
  "en": "",
  "speech_vs_text": 1.23,
  "boundary_margin": 1.262,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 15.284,
  "end": 17.99,
  "te": "The Rafale was built to be thrown off a ship by one.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.279,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 18.46,
  "end": 20.081,
  "te": "Vikrant has a ramp instead.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.279,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 20.489,
  "end": 22.073,
  "te": "The jet can leave by that ramp.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.985,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 22.42,
  "end": 23.848,
  "te": "It passed that test in Goa.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 24.253,
  "end": 25.129,
  "te": "But think about this.",
  "en": "",
  "speech_vs_text": 0.8,
  "boundary_margin": 0.661,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 25.494,
  "end": 28.995,
  "te": "Sixty-five years ago, India was throwing jets off a ship.",
  "en": "",
  "speech_vs_text": 1.13,
  "boundary_margin": 0.156,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 29.378,
  "end": 35.613,
  "te": "Today the Navy wants a catapult again — and the one India has shown so far, sits on the back of a lorry.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.156,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 35.99,
  "end": 37.245,
  "te": "So what happened in between?",
  "en": "",
  "speech_vs_text": 0.84,
  "boundary_margin": 0.415,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 37.633,
  "end": 39.588,
  "te": "And here is something you would not guess.",
  "en": "",
  "speech_vs_text": 0.89,
  "boundary_margin": 0.685,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 39.941,
  "end": 44.388,
  "te": "The electricity to throw a fighter jet costs you less than two hundred rupees.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.078,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 44.729,
  "end": 47.438,
  "te": "Yet it is one of the hardest machines on earth.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.078,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 47.77,
  "end": 49.927,
  "te": "By the end of this film, you will see why.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.59,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 50.417,
  "end": 52.356,
  "te": "Come and stand on Vikrant's deck with me.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.258,
  "confidence": "high"
 },
 {
  "line": 18,
  "start": 52.752,
  "end": 57.288,
  "te": "In front of you, the deck curves upward, like a flyover that ends in the sky.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.258,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 57.683,
  "end": 59.677,
  "te": "Do you see any moving parts on that ramp?",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.331,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 60.109,
  "end": 60.38,
  "te": "None.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 2.689,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 60.78,
  "end": 64.781,
  "te": "The jet opens its engines fully, runs, and the curve throws it up.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.631,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 65.24,
  "end": 66.232,
  "te": "Nothing you can break.",
  "en": "",
  "speech_vs_text": 0.85,
  "boundary_margin": 0.631,
  "confidence": "high"
 },
 {
  "line": 23,
  "start": 66.513,
  "end": 67.629,
  "te": "Nothing you must repair.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.35,
  "confidence": "high"
 },
 {
  "line": 24,
  "start": 68.008,
  "end": 70.372,
  "te": "You have to admit, it is a clever idea.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.35,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 70.742,
  "end": 71.582,
  "te": "But here's the catch.",
  "en": "",
  "speech_vs_text": 0.81,
  "boundary_margin": 0.255,
  "confidence": "high"
 },
 {
  "line": 26,
  "start": 71.921,
  "end": 75.867,
  "te": "On a ramp, the jet must lift itself, with its own engines.",
  "en": "",
  "speech_vs_text": 1.19,
  "boundary_margin": 0.255,
  "confidence": "high"
 },
 {
  "line": 27,
  "start": 76.169,
  "end": 77.617,
  "te": "So you take off lighter.",
  "en": "",
  "speech_vs_text": 1.18,
  "boundary_margin": 0.404,
  "confidence": "high"
 },
 {
  "line": 28,
  "start": 77.952,
  "end": 80.661,
  "te": "You carry less fuel, or fewer weapons, or both.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.317,
  "confidence": "high"
 },
 {
  "line": 29,
  "start": 81.208,
  "end": 81.88,
  "te": "How much lighter?",
  "en": "",
  "speech_vs_text": 0.74,
  "boundary_margin": 0.317,
  "confidence": "high"
 },
 {
  "line": 30,
  "start": 82.235,
  "end": 84.11,
  "te": "The Navy has not published that number.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 31,
  "start": 84.374,
  "end": 85.953,
  "te": "So I won't invent one for you.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 32,
  "start": 86.354,
  "end": 88.385,
  "te": "What nobody argues about is this.",
  "en": "",
  "speech_vs_text": 1.16,
  "boundary_margin": 0.238,
  "confidence": "high"
 },
 {
  "line": 33,
  "start": 88.723,
  "end": 92.516,
  "te": "You cannot get a heavy, slow aircraft off a ramp at all.",
  "en": "",
  "speech_vs_text": 1.3,
  "boundary_margin": 0.238,
  "confidence": "high"
 },
 {
  "line": 34,
  "start": 92.835,
  "end": 95.129,
  "te": "And which heavy aircraft matters most at sea?",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 4.839,
  "confidence": "high"
 },
 {
  "line": 35,
  "start": 95.446,
  "end": 96.446,
  "te": "The flying radar.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 1.461,
  "confidence": "high"
 },
 {
  "line": 36,
  "start": 96.788,
  "end": 101.171,
  "te": "A plane with a big dish on its back, that sees trouble long before your ship can.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.957,
  "confidence": "high"
 },
 {
  "line": 37,
  "start": 101.546,
  "end": 103.903,
  "te": "India's carriers do that job with a helicopter.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.957,
  "confidence": "high"
 },
 {
  "line": 38,
  "start": 104.263,
  "end": 104.778,
  "te": "It works.",
  "en": "",
  "speech_vs_text": 1.14,
  "boundary_margin": 2.501,
  "confidence": "high"
 },
 {
  "line": 39,
  "start": 105.07,
  "end": 110.228,
  "te": "But ask naval experts, and they will tell you, a helicopter cannot do it as well as a plane.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 1.209,
  "confidence": "high"
 },
 {
  "line": 40,
  "start": 110.641,
  "end": 112.274,
  "te": "So the ramp has a price.",
  "en": "",
  "speech_vs_text": 1.4,
  "boundary_margin": 1.209,
  "confidence": "high"
 },
 {
  "line": 41,
  "start": 112.663,
  "end": 114.053,
  "te": "Then why did India choose it?",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.305,
  "confidence": "high"
 },
 {
  "line": 42,
  "start": 114.411,
  "end": 119.368,
  "te": "To answer that, you must first see the catapult we already had, and how we let it go.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.283,
  "confidence": "high"
 },
 {
  "line": 43,
  "start": 119.874,
  "end": 122.708,
  "te": "Belfast, the fourth of March, nineteen sixty-one.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.283,
  "confidence": "high"
 },
 {
  "line": 44,
  "start": 123.082,
  "end": 128.265,
  "te": "India commissions its first aircraft carrier, bought from Britain and finished in that shipyard.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.531,
  "confidence": "high"
 },
 {
  "line": 45,
  "start": 128.677,
  "end": 130.226,
  "te": "Her name, too, is Vikrant.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.464,
  "confidence": "high"
 },
 {
  "line": 46,
  "start": 130.674,
  "end": 132.956,
  "te": "And under her deck is a steam catapult.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.464,
  "confidence": "high"
 },
 {
  "line": 47,
  "start": 133.361,
  "end": 134.867,
  "te": "How does steam throw a jet?",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.917,
  "confidence": "high"
 },
 {
  "line": 48,
  "start": 135.236,
  "end": 136.631,
  "te": "You already own a small one.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 49,
  "start": 136.907,
  "end": 138.311,
  "te": "The pressure cooker in your kitchen.",
  "en": "",
  "speech_vs_text": 0.72,
  "boundary_margin": 0.52,
  "confidence": "high"
 },
 {
  "line": 50,
  "start": 138.668,
  "end": 142.908,
  "te": "Steam builds up behind the weight, and when it goes, it goes with force.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.118,
  "confidence": "high"
 },
 {
  "line": 51,
  "start": 143.198,
  "end": 148.98,
  "te": "On the ship, that steam drives a piston along a tube under the deck, and the piston drags the jet.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.118,
  "confidence": "high"
 },
 {
  "line": 52,
  "start": 149.318,
  "end": 150.91,
  "te": "For nine years, it works.",
  "en": "",
  "speech_vs_text": 1.3,
  "boundary_margin": 0.186,
  "confidence": "high"
 },
 {
  "line": 53,
  "start": 151.231,
  "end": 156.228,
  "te": "Then, in June nineteen seventy, in Bombay, the engineers find cracks in a boiler.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.186,
  "confidence": "high"
 },
 {
  "line": 54,
  "start": 156.591,
  "end": 157.338,
  "te": "Not one crack.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.266,
  "confidence": "high"
 },
 {
  "line": 55,
  "start": 157.654,
  "end": 160.006,
  "te": "Many, in the drums that hold the water.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.266,
  "confidence": "high"
 },
 {
  "line": 56,
  "start": 160.329,
  "end": 161.42,
  "te": "You cannot weld them.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 2.1,
  "confidence": "high"
 },
 {
  "line": 57,
  "start": 161.896,
  "end": 164.367,
  "te": "And a lasting repair is not possible in India.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 58,
  "start": 164.876,
  "end": 165.836,
  "te": "Do you see what that means?",
  "en": "",
  "speech_vs_text": 0.71,
  "boundary_margin": 0.293,
  "confidence": "high"
 },
 {
  "line": 59,
  "start": 166.245,
  "end": 170.24,
  "te": "The same steam that turns the propellers, also fires the catapult.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.293,
  "confidence": "high"
 },
 {
  "line": 60,
  "start": 170.542,
  "end": 176.063,
  "te": "If you push those boilers too hard, in the words of Admiral Arun Prakash, they could simply blow up.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.319,
  "confidence": "high"
 },
 {
  "line": 61,
  "start": 176.643,
  "end": 177.97,
  "te": "Would you send that ship to war?",
  "en": "",
  "speech_vs_text": 0.82,
  "boundary_margin": 0.498,
  "confidence": "high"
 },
 {
  "line": 62,
  "start": 178.481,
  "end": 180.58,
  "te": "So the ship is held to fourteen knots.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.301,
  "confidence": "high"
 },
 {
  "line": 63,
  "start": 180.869,
  "end": 182.909,
  "te": "That is about twenty-six kilometres an hour.",
  "en": "",
  "speech_vs_text": 0.81,
  "boundary_margin": 0.301,
  "confidence": "high"
 },
 {
  "line": 64,
  "start": 183.389,
  "end": 184.473,
  "te": "Too slow for a carrier.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 1.358,
  "confidence": "high"
 },
 {
  "line": 65,
  "start": 184.832,
  "end": 188.285,
  "te": "And some very senior officers say, leave her out of the next war.",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.283,
  "confidence": "high"
 },
 {
  "line": 66,
  "start": 188.767,
  "end": 191.658,
  "te": "The Navy chief, Admiral Nanda, will not have it.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.019,
  "confidence": "check"
 },
 {
  "line": 67,
  "start": 191.963,
  "end": 198.007,
  "te": "If Vikrant sits out a war, he says, she will be called a white elephant, and naval flying will be written off.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.019,
  "confidence": "check"
 },
 {
  "line": 68,
  "start": 198.536,
  "end": 201.493,
  "te": "So it comes down to the engine room, and to one man.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.274,
  "confidence": "high"
 },
 {
  "line": 69,
  "start": 201.857,
  "end": 204.733,
  "te": "Commander Benoy Roy Chowdhury, the ship's engineer.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.274,
  "confidence": "high"
 },
 {
  "line": 70,
  "start": 205.078,
  "end": 206.603,
  "te": "His shipmates call him Beeloo.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.464,
  "confidence": "high"
 },
 {
  "line": 71,
  "start": 207.01,
  "end": 209.81,
  "te": "What would you do with a cracked boiler, and no spare?",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 72,
  "start": 210.221,
  "end": 212.588,
  "te": "Beeloo and his team put steel bands around it.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.923,
  "confidence": "high"
 },
 {
  "line": 73,
  "start": 212.991,
  "end": 215.917,
  "te": "They reset the safety valves, to accept more risk.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.494,
  "confidence": "high"
 },
 {
  "line": 74,
  "start": 216.283,
  "end": 218.566,
  "te": "And they keep the boiler room almost empty.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.484,
  "confidence": "high"
 },
 {
  "line": 75,
  "start": 219.037,
  "end": 222.762,
  "te": "Because if a drum bursts, that room fills with superheated steam.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.484,
  "confidence": "high"
 },
 {
  "line": 76,
  "start": 223.374,
  "end": 223.971,
  "te": "It holds.",
  "en": "",
  "speech_vs_text": 1.32,
  "boundary_margin": 2.412,
  "confidence": "high"
 },
 {
  "line": 77,
  "start": 224.353,
  "end": 230.936,
  "te": "On the fourth of December, nineteen seventy-one, Sea Hawk jets leave Vikrant's catapult, and strike Cox's Bazar.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.296,
  "confidence": "high"
 },
 {
  "line": 78,
  "start": 231.307,
  "end": 236.465,
  "te": "And for his work in that boiler room, Beeloo is given the Vir Chakra, a medal for bravery.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.296,
  "confidence": "high"
 },
 {
  "line": 79,
  "start": 236.828,
  "end": 239.004,
  "te": "So India did not only have a catapult.",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.44,
  "confidence": "high"
 },
 {
  "line": 80,
  "start": 239.471,
  "end": 242.916,
  "te": "India kept one alive with steel bands, and took it to war.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.412,
  "confidence": "high"
 },
 {
  "line": 81,
  "start": 243.401,
  "end": 244.703,
  "te": "Then how did we lose it?",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.412,
  "confidence": "high"
 },
 {
  "line": 82,
  "start": 245.064,
  "end": 249.887,
  "te": "In the nineteen eighties, the Navy bought the Sea Harrier, a jet that needs no catapult.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.432,
  "confidence": "high"
 },
 {
  "line": 83,
  "start": 250.334,
  "end": 256.151,
  "te": "The last planes that still needed the catapult, the old propeller planes, retired in nineteen eighty-nine.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.432,
  "confidence": "high"
 },
 {
  "line": 84,
  "start": 256.615,
  "end": 259.199,
  "te": "So the catapult came out, and a ramp went on.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.65,
  "confidence": "high"
 },
 {
  "line": 85,
  "start": 259.622,
  "end": 260.301,
  "te": "You can see why.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.798,
  "confidence": "high"
 },
 {
  "line": 86,
  "start": 260.693,
  "end": 261.597,
  "te": "It made sense then.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 1.295,
