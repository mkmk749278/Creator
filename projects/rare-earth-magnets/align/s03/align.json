[
 {
  "line": 1,
  "start": 0.0,
  "end": 2.641,
  "te": "Here's the catch, and it may surprise you.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 1.148,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 3.09,
  "end": 5.239,
  "te": "Rare earths are not actually rare.",
  "en": "",
  "speech_vs_text": 1.13,
  "boundary_margin": 1.148,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 5.76,
  "end": 8.016,
  "te": "The rare part is getting them out clean.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 8.455,
  "end": 9.623,
  "te": "There are seventeen of them.",
  "en": "",
  "speech_vs_text": 0.75,
  "boundary_margin": 0.563,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 9.999,
  "end": 12.485,
  "te": "And when you dig them up, you get them mixed together.",
  "en": "",
  "speech_vs_text": 0.74,
  "boundary_margin": 0.563,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 12.947,
  "end": 17.283,
  "te": "Think of them as seventeen brothers and sisters who look almost exactly alike.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.54,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 17.839,
  "end": 21.699,
  "te": "Nearly the same size, same habits, almost the same chemistry.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.418,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 22.18,
  "end": 25.185,
  "te": "To your eye, and to most chemicals, they look the same.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.418,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 25.638,
  "end": 28.007,
  "te": "So how do you pull one of them out of the crowd?",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.444,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 28.547,
  "end": 30.326,
  "te": "There's no single magic step.",
  "en": "",
  "speech_vs_text": 1.14,
  "boundary_margin": 0.679,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 30.66,
  "end": 35.205,
  "te": "You dissolve the mix in acid, and the liquid flows through a long row of tanks.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.217,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 35.681,
  "end": 38.765,
  "te": "Each tank pulls them apart... only a tiny bit.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.194,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 39.162,
  "end": 40.242,
  "te": "So you repeat it.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.194,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 40.607,
  "end": 41.676,
  "te": "Again and again.",
  "en": "",
  "speech_vs_text": 1.22,
  "boundary_margin": 0.951,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 42.158,
  "end": 47.151,
  "te": "A big plant can run hundreds of these tanks in a row, just to get one element clean.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.631,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 47.681,
  "end": 49.373,
  "te": "Think of it like climbing stairs.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.526,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 49.629,
  "end": 52.963,
  "te": "Each tank is one step... it lifts you only a little.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.526,
  "confidence": "high"
 },
 {
  "line": 18,
  "start": 53.497,
  "end": 55.438,
  "te": "Want one rare earth, nearly pure?",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 0.538,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 55.917,
  "end": 57.623,
  "te": "You climb hundreds of steps.",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 57.995,
  "end": 59.347,
  "te": "And that's only the first half.",
  "en": "",
  "speech_vs_text": 0.83,
  "boundary_margin": 0.616,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 59.85,
  "end": 61.266,
  "te": "The second half is faster.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.409,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 61.664,
  "end": 62.565,
  "te": "Let me run you through it.",
  "en": "",
  "speech_vs_text": 0.67,
  "boundary_margin": 0.21,
  "confidence": "check"
 },
 {
  "line": 23,
  "start": 63.017,
  "end": 65.697,
  "te": "Next, the clean rare earth becomes a metal.",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 0.21,
  "confidence": "high"
 },
 {
  "line": 24,
  "start": 66.062,
  "end": 70.288,
  "te": "You melt it with iron and boron... and that mix is called an alloy.",
  "en": "",
  "speech_vs_text": 1.15,
  "boundary_margin": 0.759,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 70.808,
  "end": 72.999,
  "te": "Then you cool it into thin pieces.",
  "en": "",
  "speech_vs_text": 1.09,
  "boundary_margin": 0.229,
  "confidence": "high"
 },
 {
  "line": 26,
  "start": 73.409,
  "end": 78.378,
  "te": "Hydrogen gas cracks those pieces, and you grind them into a powder finer than flour.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.229,
  "confidence": "high"
 },
 {
  "line": 27,
  "start": 78.835,
  "end": 86.313,
  "te": "You line that powder up inside a strong magnetic field, press it into a block, and bake it at about a thousand degrees Celsius.",
  "en": "",
