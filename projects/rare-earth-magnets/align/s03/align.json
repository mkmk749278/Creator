[
 {
  "line": 1,
  "start": 0.0,
  "end": 2.467,
  "te": "Here's the catch, and it may surprise you.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 1.091,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 3.038,
  "end": 5.35,
  "te": "Rare earths are not actually rare.",
  "en": "",
  "speech_vs_text": 1.26,
  "boundary_margin": 1.091,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 5.912,
  "end": 8.167,
  "te": "The rare part is getting them out clean.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 8.67,
  "end": 9.907,
  "te": "There are seventeen of them.",
  "en": "",
  "speech_vs_text": 0.82,
  "boundary_margin": 0.605,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 10.36,
  "end": 12.881,
  "te": "And when you dig them up, you get them mixed together.",
  "en": "",
  "speech_vs_text": 0.79,
  "boundary_margin": 0.605,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 13.348,
  "end": 17.857,
  "te": "Think of them as seventeen brothers and sisters who look almost exactly alike.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.385,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 18.274,
  "end": 22.285,
  "te": "Nearly the same size, same habits, almost the same chemistry.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 0.385,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 22.786,
  "end": 25.618,
  "te": "To your eye, and to most chemicals, they look the same.",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 0.431,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 26.062,
  "end": 28.316,
  "te": "So how do you pull one of them out of the crowd?",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.431,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 28.88,
  "end": 30.487,
  "te": "There's no single magic step.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 0.724,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 30.885,
  "end": 35.133,
  "te": "You dissolve the mix in acid, and the liquid flows through a long row of tanks.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.186,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 35.575,
  "end": 38.624,
  "te": "Each tank pulls them apart... only a tiny bit.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.186,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 39.07,
  "end": 39.821,
  "te": "So you repeat it.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.378,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 40.202,
  "end": 41.304,
  "te": "Again and again.",
  "en": "",
  "speech_vs_text": 1.3,
  "boundary_margin": 0.36,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 41.836,
  "end": 46.78,
  "te": "A big plant can run hundreds of these tanks in a row, just to get one element clean.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.36,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 47.28,
  "end": 48.406,
  "te": "It's like washing rice.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.848,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 48.764,
  "end": 50.587,
  "te": "One wash takes out a little dirt.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 18,
  "start": 51.011,
  "end": 52.181,
  "te": "You want it perfectly clean?",
  "en": "",
  "speech_vs_text": 0.78,
  "boundary_margin": 0.183,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 52.627,
  "end": 54.979,
  "te": "You keep washing... hundreds of times.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.183,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 55.426,
  "end": 56.791,
  "te": "And that's only the first half.",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 0.613,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 57.257,
  "end": 58.73,
  "te": "The second half is faster.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.249,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 59.157,
  "end": 59.929,
  "te": "Let me run you through it.",
  "en": "",
  "speech_vs_text": 0.59,
  "boundary_margin": 0.2,
  "confidence": "check"
 },
 {
  "line": 23,
  "start": 60.535,
  "end": 63.212,
  "te": "Next, the clean rare earth becomes a metal.",
  "en": "",
  "speech_vs_text": 1.13,
  "boundary_margin": 0.2,
  "confidence": "high"
 },
 {
  "line": 24,
  "start": 63.674,
  "end": 70.259,
  "te": "You melt that metal with iron and boron — a mix like that is called an alloy — and cool it into thin pieces.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.207,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 70.73,
  "end": 76.397,
  "te": "Then hydrogen gas cracks those pieces, and you grind them into a powder much smaller than flour.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.207,
  "confidence": "high"
 },
 {
  "line": 26,
  "start": 76.865,
  "end": 83.996,
  "te": "You line that powder up inside a strong magnetic field, press it into a block, and bake it at about a thousand degrees.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.265,
  "confidence": "high"
 },
 {
  "line": 27,
  "start": 84.432,
  "end": 87.364,
  "te": "Only at the very end do you switch on its magnetism.",
  "en": "",
  "speech_vs_text": 1.09,
  "boundary_margin": 0.265,
  "confidence": "high"
 },
 {
  "line": 28,
  "start": 87.885,
  "end": 90.257,
  "te": "That's when you finally have a magnet.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 1.202,
  "confidence": "high"
 }
]