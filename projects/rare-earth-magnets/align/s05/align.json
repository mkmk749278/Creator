[
 {
  "line": 1,
  "start": 0.0,
  "end": 1.354,
  "te": "So what about India?",
  "en": "",
  "speech_vs_text": 1.28,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 1.832,
  "end": 3.276,
  "te": "We had the sand all along.",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 3.743,
  "end": 4.501,
  "te": "What stopped us?",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 5.035,
  "end": 6.053,
  "te": "I'll give you two things.",
  "en": "",
  "speech_vs_text": 0.81,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 6.49,
  "end": 7.847,
  "te": "What's inside our sand.",
  "en": "",
  "speech_vs_text": 1.14,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 8.249,
  "end": 9.746,
  "te": "And what we did with it.",
  "en": "",
  "speech_vs_text": 1.26,
  "boundary_margin": 0.494,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 10.227,
  "end": 14.038,
  "te": "In India, rare earths mostly come in a mineral called monazite.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.494,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 14.398,
  "end": 18.039,
  "te": "You'll find it in the dark sand on some beaches in the south and east.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 2.535,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 18.457,
  "end": 20.765,
  "te": "And monazite has a surprise inside it.",
  "en": "",
  "speech_vs_text": 1.13,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 21.183,
  "end": 21.677,
  "te": "Thorium.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 1.074,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 22.138,
  "end": 25.201,
  "te": "It's radioactive, and it can be used as nuclear fuel.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 0.43,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 25.594,
  "end": 29.857,
  "te": "And that one fact, as you'll see, changed how India handled this sand.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.369,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 30.375,
  "end": 33.692,
  "te": "So by law, monazite is treated as an atomic material.",
  "en": "",
  "speech_vs_text": 1.14,
  "boundary_margin": 0.369,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 34.054,
  "end": 38.397,
  "te": "Under the Atomic Energy Act, only one government company is allowed to process it.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.163,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 38.703,
  "end": 42.575,
  "te": "Indian Rare Earths Limited — today it's simply called I.R.E.L.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.163,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 43.042,
  "end": 45.242,
  "te": "If you think about it, that kept things safe.",
  "en": "",
  "speech_vs_text": 0.82,
  "boundary_margin": 0.346,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 45.78,
  "end": 48.497,
  "te": "But for decades it also kept the business small.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.346,
  "confidence": "high"
 },
 {
  "line": 18,
  "start": 48.846,
  "end": 53.497,
  "te": "Even India's own mining bureau wrote that demand for rare earths at home was limited.",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.27,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 53.978,
  "end": 55.319,
  "te": "And here's the painful part.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.27,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 55.649,
  "end": 60.809,
  "te": "In twenty twenty-four, I.R.E.L. produced about two thousand nine hundred tonnes of rare earths.",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.426,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 61.096,
  "end": 65.686,
  "te": "And more than a thousand tonnes went to Japan, under a deal signed back in twenty twelve.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.746,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 66.213,
  "end": 66.791,
  "te": "Think about it.",
  "en": "",
  "speech_vs_text": 0.73,
  "boundary_margin": 0.892,
  "confidence": "high"
 },
 {
  "line": 23,
  "start": 67.093,
  "end": 70.745,
  "te": "You send the raw material out... and you buy the finished magnets in.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.375,
  "confidence": "high"
 },
 {
  "line": 24,
  "start": 71.175,
  "end": 74.466,
  "te": "So you sell the cheap part, and you buy back the costly part.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.375,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 74.937,
  "end": 76.501,
  "te": "There's one more honest problem.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 1.196,
  "confidence": "high"
 },
 {
  "line": 26,
  "start": 76.851,
  "end": 80.322,
  "te": "Our sand is rich in the lighter rare earths, like neodymium.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 1.932,
  "confidence": "high"
 }
]