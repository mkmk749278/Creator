  "confidence": "high"
 },
 {
  "line": 13,
  "start": 40.687,
  "end": 49.093,
  "te": "Back in April, Rajiv Bajaj had warned — if China stopped these magnets, India's whole electric vehicle industry could halt within weeks.",
