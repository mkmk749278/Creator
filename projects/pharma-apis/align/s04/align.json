  "te": "And that's exactly where India's story turns.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.232,
  "confidence": "high"
 },
 {
  "line": 26,
  "start": 83.123,
  "end": 84.679,
  "te": "Now, here's what we got wrong.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.232,
  "confidence": "high"
 },
 {
