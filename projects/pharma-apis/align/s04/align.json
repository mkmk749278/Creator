  "start": 76.565,
  "end": 79.453,
  "te": "The country with the biggest tanks and the cheapest power.",
  "en": "",
  "speech_vs_text": 0.84,
  "boundary_margin": 0.557,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 79.919,
