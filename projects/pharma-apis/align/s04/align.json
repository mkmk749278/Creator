[
 {
  "line": 1,
  "start": 0.0,
  "end": 4.89,
  "te": "Many medicines, like paracetamol, are cooked from chemicals, step by step.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 0.394,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 5.515,
  "end": 6.728,
  "te": "Penicillin is different.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.394,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 7.168,
  "end": 8.426,
  "te": "Penicillin is grown.",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 0.884,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 9.004,
  "end": 13.166,
  "te": "You take a special mould... a cousin of the green patches you've seen on old bread.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.763,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 13.724,
  "end": 17.37,
  "te": "You put it in a giant steel tank, and you feed it sugar and air.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 0.499,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 17.976,
  "end": 20.698,
  "te": "For about a week, the tank runs day and night.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.499,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 21.155,
  "end": 24.845,
  "te": "The mould eats, grows, and gives out penicillin into the liquid.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.532,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 25.379,
  "end": 29.339,
  "te": "And if even one stray germ gets in, you can lose the whole batch.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.195,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 29.827,
  "end": 32.161,
  "te": "Then you take the penicillin out and clean it.",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 0.195,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 32.608,
  "end": 35.026,
  "te": "This first powder is called penicillin G.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.328,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 35.554,
  "end": 38.15,
  "te": "Next, it's turned into a smaller base powder.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.328,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 38.62,
  "end": 42.335,
  "te": "Factories call it six A.P.A., but let's just call it the base.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.356,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 42.864,
  "end": 48.063,
  "te": "From that base, factories make amoxicillin — the antibiotic in so many strips at home.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.356,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 48.631,
  "end": 50.366,
  "te": "Now here's the secret of this business.",
  "en": "",
  "speech_vs_text": 0.83,
  "boundary_margin": 0.972,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 50.853,
  "end": 53.05,
  "te": "A bigger tank makes the powder cheaper.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 53.448,
  "end": 54.248,
  "te": "Much cheaper.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 54.752,
  "end": 55.048,
  "te": "Why?",
  "en": "",
  "speech_vs_text": 1.47,
  "boundary_margin": 1.359,
  "confidence": "check"
 },
 {
  "line": 18,
  "start": 55.555,
  "end": 61.292,
  "te": "The tank must stay perfectly clean, cool, and full of air, every hour of every day.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.224,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 61.787,
  "end": 64.652,
  "te": "That takes a lot of power, water and steam.",
  "en": "",
  "speech_vs_text": 1.22,
  "boundary_margin": 0.224,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 65.195,
  "end": 66.077,
  "te": "Think of a flour mill.",
  "en": "",
  "speech_vs_text": 0.77,
  "boundary_margin": 0.164,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 66.547,
  "end": 69.822,
  "te": "A big chakki grinds each kilo cheaper than a small one.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.164,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 70.304,
  "end": 74.254,
  "te": "Double your tank, and your costs don't double... but your output does.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.25,
  "confidence": "high"
 },
 {
  "line": 23,
  "start": 74.645,
  "end": 76.183,
  "te": "So you can guess who wins.",
  "en": "",
  "speech_vs_text": 1.15,
  "boundary_margin": 0.25,
  "confidence": "high"
 },
 {
