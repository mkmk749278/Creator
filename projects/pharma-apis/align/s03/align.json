  "confidence": "high"
 },
 {
  "line": 13,
  "start": 39.408,
  "end": 44.903,
  "te": "India has been free for less than seven years, and it's building a factory to make its own penicillin.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.309,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 45.408,
  "end": 47.69,
  "te": "Penicillin was the miracle drug of that time.",
