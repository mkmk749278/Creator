[
 {
  "start": 0.0,
  "end": 3.67,
  "text": "నార్మల్ గా ఒక మనిషి breath hold చేసి ఎంతసేపు"
 },
 {
  "start": 3.67,
  "end": 6.18,
  "text": "ఉండగలడు? 30 seconds, 1 minute,"
 },
 {
  "start": 6.44,
  "end": 8.61,
  "text": "మహా అయితే 2 minutes. అంతే కదా?"
 },
 {
  "start": 8.61,
  "end": 12.3,
  "text": "2 minutes దాటితే lungs మండిపోవడం స్టార్ట్ అవుతుంది."
 },
 {
  "start": 12.59,
  "end": 15.6,
  "text": "3 minutes దాటితే brain cells కి oxygen అందక,"
 },
 {
  "start": 15.6,
  "end": 18.07,
  "text": "బాడీలో dangerous changes మొదలవుతాయ్."
 },
 {
  "start": 18.07,
  "end": 19.22,
  "text": "6 minutes దాటితే,"
 },
 {
  "start": 19.22,
  "end": 22.07,
  "text": "medical science ప్రకారం brain dead అయిపోయే"
 },
 {
  "start": 22.07,
  "end": 23.09,
  "text": "chances ఉంటాయ్."
 },
 {
  "start": 23.09,
  "end": 27.17,
  "text": "కానీ ఒక person ఏకంగా 16 minutes పాటు..."
 },
 {
  "start": 27.45,
  "end": 30.22,
  "text": "కనీసం ఒక్కసారి కూడా breath తీసుకోకుండా,"
 },
 {
  "start": 30.22,
  "end": 31.85,
  "text": "కనురెప్ప కూడా వేయకుండా,"
 },
 {
  "start": 31.85,
  "end": 35.11,
  "text": "వందలాది cameras ముందు అలా still గా నిలబడిపోతే?"
 },
 {
  "start": 35.52,
  "end": 37.61,
  "text": "కళ్ళలోంచి tears కారుతున్నాయ్,"
 },
 {
  "start": 37.61,
  "end": 40.14,
  "text": "బాడీలో subtle shaking కనిపిస్తోంది,"
 },
 {
  "start": 40.14,
  "end": 42.3,
  "text": "కానీ face లో మాత్రం zero fear."
 },
 {
  "start": 42.52,
  "end": 44.47,
  "text": "చూపులో ఎలాంటి movement లేదు."
 },
 {
  "start": 44.47,
  "end": 46.64,
  "text": "ఇదో magic trick అనుకుంటున్నారా?"
 },
 {
  "start": 46.64,
  "end": 48.66,
  "text": "లేక camera editing gimmick ఆ?"
 },
 {
  "start": 48.98,
  "end": 52.01,
  "text": "Definitely కాదు. వందలాది మంది చూస్తుండగా,"
 },
 {
  "start": 52.01,
  "end": 54.97,
  "text": "live media cameras ముందే జరిగిన absolute"
 },
 {
  "start": 54.97,
  "end": 56.0,
  "text": "sensation ఇది."
 },
 {
  "start": 56.25,
  "end": 58.75,
  "text": "ఈ unbelievable incident జరిగింది ముంబైలో."
 },
 {
  "start": 58.75,
  "end": 61.25,
  "text": "తన upcoming international Hollywood movie"
 },
 {
  "start": 61.25,
  "end": 63.75,
  "text": "Street Fighter promotion event కి వచ్చారు"
 },
 {
  "start": 63.75,
  "end": 66.47,
  "text": "Indian martial arts star విద్యుత్ జమ్వాల్."
 },
 {
  "start": 66.62,
  "end": 69.24,
  "text": "ఈ movie లో ఆయన play చేస్తున్న character,"
 },
 {
  "start": 69.24,
  "end": 71.79,
  "text": "legendary Indian yogic warrior Dhalsim."
 },
 {
  "start": 71.79,
  "end": 73.62,
  "text": "Stage మీదకి వచ్చిన విద్యుత్,"
 },
 {
  "start": 73.65,
  "end": 75.58,
  "text": "mic పట్టుకుని మాట్లాడలేదు,"
 },
 {
  "start": 75.58,
  "end": 77.07,
  "text": "ఏ speeches ఇవ్వలేదు."
 },
 {
  "start": 77.07,
  "end": 80.05,
  "text": "Silent గా ఒక చోట statue లా నిలబడిపోయారు."
 },
 {
  "start": 80.34,
  "end": 82.01,
  "text": "First 2 minutes అయిపోయాయ్."
 },
 {
  "start": 82.01,
  "end": 84.84,
  "text": "ఏదో performance కోసం ready అవుతున్నారేమో అని"
 },
 {
  "start": 84.84,
  "end": 87.6,
  "text": "audience అనుకున్నారు. 5 minutes అయిపోయింది."
 },
 {
  "start": 87.85,
  "end": 90.6,
  "text": "ఆయన chest లో గానీ stomach లో గానీ చిన్నపాటి"
 },
 {
  "start": 90.6,
  "end": 91.82,
  "text": "movement కూడా లేదు."
 },
 {
  "start": 91.82,
  "end": 93.67,
  "text": "Breathing అసలు కనిపించట్లేదు."
 },
 {
  "start": 93.95,
  "end": 97.77,
  "text": "8 minutes, 10 minutes, 12 minutes,"
 },
 {
  "start": 97.79,
  "end": 99.53,
  "text": "continuous గా open eyes,"
 },
 {
  "start": 99.53,
  "end": 101.55,
  "text": "ఒక్కసారి కూడా blink చేయలేదు."
 },
 {
  "start": 101.75,
  "end": 104.66,
  "text": "కళ్ళలోంచి continuous గా tears కారిపోతున్నాయ్."
 },
 {
  "start": 104.66,
  "end": 106.41,
  "text": "Stage చుట్టూ ఉన్న audience,"
 },
 {
  "start": 106.41,
  "end": 110.03,
  "text": "press reporters ఏం జరుగుతుందో అర్థం కాక blank అయిపోయారు."
 },
 {
  "start": 110.3,
  "end": 112.29,
  "text": "14 minutes దగ్గర ఆయన legs లో,"
 },
 {
  "start": 112.29,
  "end": 114.96,
  "text": "బాడీలో heavy shivering స్టార్ట్ అయింది."
 },
 {
  "start": 114.96,
  "end": 118.56,
  "text": "ఇక నిలబడలేక collapse అయిపోతారేమో అనుకుంటున్న moment లో,"
 },
 {
  "start": 118.83,
  "end": 121.92,
  "text": "exactly 16 minutes complete అవగానే విద్యుత్ ఆ"
 },
 {
  "start": 121.92,
  "end": 123.71,
  "text": "state నుంచి బయటకు వచ్చారు."
 },
 {
  "start": 123.77,
  "end": 126.81,
  "text": "పక్కనే ఉన్న శంఖాన్ని తీసి గంభీరంగా ఊదారు."
 },
 {
  "start": 127.06,
  "end": 129.75,
  "text": "The entire hall went pin-drop silent."
 },
 {
  "start": 130.21,
  "end": 132.13,
  "text": "అసలు అక్కడ ఏం జరిగింది?"
 },
 {
  "start": 132.23,
  "end": 135.79,
  "text": "16 minutes breath hold చేయడం humanly possible ఏనా?"
 },
 {
  "start": 135.79,
  "end": 138.44,
  "text": "అసలు breath hold చేసినప్పుడు మన బాడీలో ఏం"
 },
 {
  "start": 138.44,
  "end": 140.57,
  "text": "జరుగుతుందో scientific గా చూద్దాం."
 },
 {
  "start": 140.91,
  "end": 142.56,
  "text": "మనలో చాలామంది అనుకుంటారు,"
 },
 {
  "start": 142.56,
  "end": 145.2,
  "text": "బాడీలో oxygen అయిపోవడం వల్లే మనకు breath"
 },
 {
  "start": 145.2,
  "end": 146.65,
  "text": "తీసుకోవాలనిపిస్తుందని."
 },
 {
  "start": 146.65,
  "end": 148.99,
  "text": "But scientifically అది తప్పు."
 },
 {
  "start": 149.3,
  "end": 150.77,
  "text": "మనం శ్వాస ఆపినప్పుడు,"
 },
 {
  "start": 150.77,
  "end": 153.7,
  "text": "మన cells produce చేసే carbon dioxide రక్తం"
 },
 {
  "start": 153.7,
  "end": 154.96,
  "text": "లోపలే ఉండిపోతుంది."
 },
 {
  "start": 154.96,
  "end": 157.9,
  "text": "దీని వల్ల blood acid లాగా మారిపోతుంది."
 },
 {
  "start": 158.16,
  "end": 161.16,
  "text": "మన brain లో ఉండే chemoreceptors వెంటనే alert"
 },
 {
  "start": 161.16,
  "end": 162.86,
  "text": "అయిపోయి, \"ఇక ఆగడం కుదరదు,"
 },
 {
  "start": 162.86,
  "end": 164.36,
  "text": "వెంటనే breath తీసుకో!\""
 },
 {
  "start": 164.61,
  "end": 167.83,
  "text": "అంటూ diaphragm కి emergency signals పంపిస్తాయ్."
 },
 {
  "start": 167.83,
  "end": 170.99,
  "text": "దీన్నే science లో hypercapnic response అంటారు."
 },
 {
  "start": 171.23,
  "end": 173.83,
  "text": "Time గడిచే కొద్దీ diaphragm involuntary"
 },
 {
  "start": 173.83,
  "end": 175.23,
  "text": "spasms కి గురవుతుంది."
 },
 {
  "start": 175.23,
  "end": 177.88,
  "text": "విద్యుత్ కి last minutes లో legs shiver"
 },
 {
  "start": 177.88,
  "end": 179.71,
  "text": "అవ్వడానికి main reason ఇదే."
 },
 {
  "start": 179.96,
  "end": 183.03,
  "text": "ఆయన బాడీ లోపల blood లో carbon dioxide extreme"
 },
 {
  "start": 183.03,
  "end": 186.1,
  "text": "level కి చేరుకుందని అది clear గా చూపిస్తోంది."
 },
 {
  "start": 186.35,
  "end": 188.91,
  "text": "ఇక్కడ official world records చూస్తే మీరే"
 },
 {
  "start": 188.91,
  "end": 189.8,
  "text": "shock అవుతారు."
 },
 {
  "start": 189.93,
  "end": 192.01,
  "text": "Normal room air breathe చేసి,"
 },
 {
  "start": 192.01,
  "end": 194.94,
  "text": "water లో breath hold చేసిన official world"
 },
 {
  "start": 194.94,
  "end": 197.95,
  "text": "record just 11 minutes 35 seconds మాత్రమే."
 },
 {
  "start": 197.78,
  "end": 200.24,
  "text": "మరి 24 minutes records ఎలా వచ్చాయ్"
 },
 {
  "start": 200.24,
  "end": 201.32,
  "text": "అనుకుంటున్నారా?"
 },
 {
  "start": 201.64,
  "end": 204.39,
  "text": "వాళ్ళు challenge కి ముందు almost half an hour"
 },
 {
  "start": 204.39,
  "end": 207.14,
  "text": "పాటు pure medical oxygen ని breathe చేస్తారు."
 },
 {
  "start": 207.14,
  "end": 210.86,
  "text": "కానీ విద్యుత్ జమ్వాల్ ఎక్కడా pure oxygen తీసుకోలేదు,"
 },
 {
  "start": 211.06,
  "end": 212.76,
  "text": "water లో float అవ్వలేదు."
 },
 {
  "start": 212.76,
  "end": 215.52,
  "text": "Live stage మీద direct గా నిలబడి చేశారు."
 },
 {
  "start": 215.52,
  "end": 218.28,
  "text": "మరి 16 minutes ఆయన ఎలా survive అయ్యారు?"
 },
 {
  "start": 218.28,
  "end": 221.9,
  "text": "ఈ mystery కి answer విద్యుత్ స్వయంగా reveal చేశారు."
 },
 {
  "start": 222.17,
  "end": 224.03,
  "text": "అదే పతంజలి యోగ సూత్రాస్."
 },
 {
  "start": 224.03,
  "end": 227.52,
  "text": "ఈ demonstration లో ఆయన రెండు powerful ancient"
 },
 {
  "start": 227.52,
  "end": 229.69,
  "text": "yogic techniques use చేశారు."
 },
 {
  "start": 230.0,
  "end": 234.58,
  "text": "1. త్రాటక. త్రాటక అంటే blink చేయకుండా ఒకే point ని"
 },
 {
  "start": 234.58,
  "end": 236.96,
  "text": "continuous గా focus చేయడం."
 },
 {
  "start": 237.28,
  "end": 240.04,
  "text": "కళ్ళ నుంచి naturally tears వచ్చేంతవరకు ఈ"
 },
 {
  "start": 240.04,
  "end": 241.28,
  "text": "practice చేస్తారు."
 },
 {
  "start": 241.28,
  "end": 244.46,
  "text": "ఇది మన nervous system ని completely calm చేసి,"
 },
 {
  "start": 244.74,
  "end": 247.62,
  "text": "brain ని deep alpha waves లోకి shift చేస్తుంది."
 },
 {
  "start": 247.62,
  "end": 250.48,
  "text": "2. And most powerful secret,"
 },
 {
  "start": 250.83,
  "end": 255.13,
  "text": "కేవల కుంభక. Normal ప్రాణాయామంలో breath పీల్చి hold చేయడం,"
 },
 {
  "start": 255.13,
  "end": 257.47,
  "text": "లేదా వదిలి hold చేయడం చేస్తారు."
 },
 {
  "start": 257.69,
  "end": 261.05,
  "text": "కానీ కేవల కుంభకలో mind completely still"
 },
 {
  "start": 261.05,
  "end": 264.85,
  "text": "అయిపోయినప్పుడు, శ్వాస దానంతట అదే ఆగిపోతుంది."
 },
 {
  "start": 265.11,
  "end": 268.05,
  "text": "ఈ state లో human body ఒక hypometabolic state"
 },
 {
  "start": 268.05,
  "end": 269.32,
  "text": "లోకి వెళ్ళిపోతుంది."
 },
 {
  "start": 269.32,
  "end": 271.79,
  "text": "Heart rate drastically drop అవుతుంది."
 },
 {
  "start": 272.02,
  "end": 274.85,
  "text": "Blood flow కేవలం brain and heart కి మాత్రమే"
 },
 {
  "start": 274.85,
  "end": 276.04,
  "text": "redirect అవుతుంది."
 },
 {
  "start": 276.04,
  "end": 280.74,
  "text": "బాడీకి oxygen requirement almost 40–50% పడిపోతుంది."
 },
 {
  "start": 281.0,
  "end": 284.64,
  "text": "దీంతో పాటు బయటకి కంటికి breath ఆగిపోయినట్లు కనిపించినా,"
 },
 {
  "start": 284.64,
  "end": 287.08,
  "text": "nose through microscopic level లో air"
 },
 {
  "start": 287.08,
  "end": 288.8,
  "text": "exchange జరుగుతూ ఉండొచ్చు."
 },
 {
  "start": 289.09,
  "end": 291.3,
  "text": "దీన్నే micro-ventilation అంటారు."
 },
 {
  "start": 291.3,
  "end": 294.47,
  "text": "Indian history లో దీనికి solid proofs ఉన్నాయ్."
 },
 {
  "start": 294.81,
  "end": 296.41,
  "text": "1837 లో లాహోర్ లో,"
 },
 {
  "start": 296.41,
  "end": 298.9,
  "text": "సాధు హరిదాస్ అనే గొప్ప యోగి,"
 },
 {
  "start": 298.9,
  "end": 303.43,
  "text": "British doctors ముందే ఒక sealed box లో 40 days పాటు"
 },
 {
  "start": 303.73,
  "end": 307.11,
  "text": "underground సమాధి స్థితిలో ఉండి సజీవంగా బయటికొచ్చారు."
 },
 {
  "start": 307.17,
  "end": 310.07,
  "text": "మన traditional యోగాకి అంత power ఉంది."
 },
 {
  "start": 310.26,
  "end": 313.0,
  "text": "కానీ ఇది ఎవరైనా overnight లో చేసేయొచ్చా?"
 },
 {
  "start": 313.36,
  "end": 315.38,
  "text": "Absolutely impossible!"
 },
 {
  "start": 315.38,
  "end": 318.81,
  "text": "ఈ 16 minutes stillness వెనుక 35 years of"
 },
 {
  "start": 318.81,
  "end": 320.7,
  "text": "intense training ఉంది."
 },
 {
  "start": 321.01,
  "end": 323.61,
  "text": "విద్యుత్ జమ్వాల్ Army family లో పుట్టిన,"
 },
 {
  "start": 323.61,
  "end": 327.05,
  "text": "just 3 years age లోనే Kerala లోని ఒక ఆశ్రమంలో చేరారు."
 },
 {
  "start": 327.33,
  "end": 330.33,
  "text": "World's oldest martial art అయిన కలరిపయట్టుని"
 },
 {
  "start": 330.33,
  "end": 332.93,
  "text": "ఆయన 35 years గా practice చేస్తున్నారు."
